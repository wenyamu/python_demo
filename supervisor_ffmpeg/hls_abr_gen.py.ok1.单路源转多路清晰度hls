#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
HLS ABR 多清晰度转码命令生成器（索引对齐版）
=================================================

结构约定（与手写模板完全一致）：
  * 输出流索引 0 固定留给最高清档：源那一路，默认 -c:v:0 copy（省 CPU）
  * 其余档位从索引 1 开始，依次 1、2、3 ...
  * 滤镜输出命名与输出流索引严格对应：[v1out]/[a1] -> -c:v:1/-c:a:1
  * 索引 0 号档直接 -map 0:v / 0:a（不进滤镜）
  * 索引 1..N-1 号档走 filter_complex（split/scale + asplit）
  * 音频每档独立成流，避免 "Same elementary stream" 报错

用法示例：
  # 4K 源 -> 4k(copy)/2k/1080p/720p 四档，只打印命令
  python3 hls_abr_gen.py -i rtsp://localhost:8554/live/source -o /mnt/hls \
      --presets 4k,2k,1080p,720p

  # 确认无误后直接执行
  python3 hls_abr_gen.py -i rtsp://localhost:8554/live/source -o /mnt/hls \
      --presets 4k,2k,1080p,720p --run

  # 香橙派用硬件编码（RK3588）
  python3 hls_abr_gen.py -i rtmp://192.168.1.121:1935/live/src -o /mnt/hls \
      --presets 1080p,720p,480p --hw rkmpp --run

  # 源是 H.265，最高档也必须转码（不能 copy）
  python3 hls_abr_gen.py -i rtmp://src -o /mnt/hls --presets 1080p,720p --no-copy-top
"""

import argparse
import subprocess
import sys
import os

# ========== 预设档位：(名称, 宽, 高, 视频码率bps) ==========
PRESETS = {
    "240p":  (426,  240,    400_000),
    "360p":  (640,  360,    800_000),
    "480p":  (854,  480,  1_200_000),
    "720p":  (1280, 720,  2_500_000),
    "1080p": (1920, 1080, 5_000_000),
    "2k":    (2560, 1440, 9_000_000),
    "4k":    (3840, 2160, 20_000_000),
}

# 编码器
HW_ENCODERS = {
    "software": "libx264",
    "rkmpp":    "h264_rkmpp",
    "vaapi":    "h264_vaapi",
    "nvenc":    "h264_nvenc",
}

NET_SCHEMES = ("rtmp://", "rtsp://", "srt://", "http://", "https://")


def fmt_rate(bps):
    """码率输出：能整除 1000 就写成 xxxk，否则写原始 bps。"""
    if bps % 1000 == 0:
        return f"{bps // 1000}k"
    return str(bps)


def parse_bitrates(text):
    """解析码率字符串，支持 k/m 后缀，如 20000k,9000k,5000k,2500k"""
    out = []
    for b in text.split(","):
        b = b.strip().lower()
        mult = 1
        if b.endswith("k"):
            mult, b = 1_000, b[:-1]
        elif b.endswith("m"):
            mult, b = 1_000_000, b[:-1]
        out.append(int(float(b) * mult))
    return out


def encoder_opts(idx, br, encoder, mf, bf_, x264_preset):
    """各档位的编码器专属参数。"""
    opts = []
    if encoder == "libx264":
        opts += [f"-maxrate:v:{idx}", fmt_rate(int(br * mf)),
                 f"-bufsize:v:{idx}", fmt_rate(int(br * bf_))]
        if x264_preset and x264_preset.lower() != "none":
            opts += [f"-preset:v:{idx}", x264_preset]
    elif encoder == "h264_rkmpp":
        opts += [f"-rc_mode:v:{idx}", "AVBR"]
    elif encoder == "h264_nvenc":
        opts += [f"-rc:v:{idx}", "cbr"]
    return opts


def build_groups(args):
    """返回 (groups, presets, copy_top, audio_copy, gop, warn)。"""
    warn = []

    # ---- 解析档位 ----
    names = [p.strip().lower() for p in args.presets.split(",") if p.strip()]
    if not names:
        print("[错误] --presets 不能为空", file=sys.stderr)
        sys.exit(1)
    for n in names:
        if n not in PRESETS:
            print(f"[错误] 未知档位 '{n}'，可用：{', '.join(PRESETS.keys())}", file=sys.stderr)
            sys.exit(1)
    dup = sorted({n for i, n in enumerate(names) if n in names[:i]})
    if dup:
        print(f"[错误] 档位重复：{', '.join(dup)}", file=sys.stderr)
        sys.exit(1)

    presets = []
    for n in names:
        w, h, br = PRESETS[n]
        presets.append((n, w, h, br))

    # ---- 码率覆盖 ----
    if args.bitrates:
        brs = parse_bitrates(args.bitrates)
        if len(brs) != len(presets):
            print(f"[错误] --bitrates 数量({len(brs)})与档位数量({len(presets)})不一致", file=sys.stderr)
            sys.exit(1)
        presets = [(n, w, h, brs[i]) for i, (n, w, h, _) in enumerate(presets)]

    # ---- 索引 0（copy 档）单独指定码率（只用于算 BANDWIDTH）----
    if args.top_bitrate:
        tb = parse_bitrates(args.top_bitrate)
        if len(tb) != 1:
            print("[错误] --top-bitrate 只接受一个值，如 20000k", file=sys.stderr)
            sys.exit(1)
        n, w, h, _ = presets[0]
        presets[0] = (n, w, h, tb[0])

    N = len(presets)
    copy_top = args.copy_top
    audio_copy = args.audio_copy
    encoder = HW_ENCODERS[args.hw]
    fps = args.fps
    hls_time = args.hls_time
    audio_br = args.audio_bitrate
    out_dir = args.output.rstrip("/")
    src = args.input
    mf, bf_ = args.maxrate_factor, args.bufsize_factor

    # ---- GOP：优先用 --gop（帧数），否则 fps × --gop-seconds ----
    if args.gop:
        gop = args.gop
        gop_seconds = gop / fps
    else:
        gop_seconds = args.gop_seconds
        gop = int(round(fps * gop_seconds))
    if gop <= 0:
        print("[错误] GOP 必须为正数", file=sys.stderr)
        sys.exit(1)
    if abs(hls_time / gop_seconds - round(hls_time / gop_seconds)) > 1e-6:
        warn.append(
            f"GOP={gop_seconds:g}s 不能整除 hls_time={hls_time}s，"
            f"分片长度会不整齐；建议改成 {hls_time}s 或它能整除的值"
        )

    # 索引 0 固定给最高清档；其余从 1 开始
    vid_from_filter = list(range(1, N)) if copy_top else list(range(0, N))
    aud_from_filter = list(range(1, N))       # 索引 0 音频直接 map 源音频

    # ---------- filter_complex ----------
    filt_parts = []
    if vid_from_filter:
        labels = "".join(f"[v{i}]" for i in vid_from_filter)
        seg = [f"[0:v]split={len(vid_from_filter)}{labels}"]
        for i in vid_from_filter:
            _, w, h, _ = presets[i]
            seg.append(f"[v{i}]scale={w}:{h}[v{i}out]")
        filt_parts.append("; ".join(seg))
    if aud_from_filter:
        alabels = "".join(f"[a{i}]" for i in aud_from_filter)
        filt_parts.append(f"[0:a]asplit={len(aud_from_filter)}{alabels}")
    filter_complex = "; ".join(filt_parts)

    # ---------- 命令分组 ----------
    groups = []

    head = ["ffmpeg"]
    if args.loglevel:
        head += ["-loglevel", args.loglevel]
    if (args.re or src.startswith(NET_SCHEMES)) and not src.startswith("/dev/"):
        head.append("-re")
    if args.reconnect and src.startswith(NET_SCHEMES):
        head += ["-reconnect", "1", "-reconnect_at_eof", "1",
                 "-reconnect_streamed", "1", "-reconnect_delay_max", "2"]
    head += ["-i", src]
    groups.append(head)

    if filter_complex:
        groups.append(["-filter_complex", filter_complex])

    # ---- 视频映射（先索引 0，再 1..N-1）----
    top_name, top_w, top_h, top_br = presets[0]
    if copy_top:
        # -b:v:0 只用于计算 master 里的 BANDWIDTH，不会触发重编码
        groups.append(["-map", "0:v", "-c:v:0", "copy", "-b:v:0", fmt_rate(top_br)])
    else:
        g = ["-map", "[v0out]", "-c:v:0", encoder, "-b:v:0", fmt_rate(top_br)]
        g += encoder_opts(0, top_br, encoder, mf, bf_, args.x264_preset)
        groups.append(g)

    for i in range(1, N):
        name, w, h, br = presets[i]
        g = ["-map", f"[v{i}out]", f"-c:v:{i}", encoder, f"-b:v:{i}", fmt_rate(br)]
        g += encoder_opts(i, br, encoder, mf, bf_, args.x264_preset)
        groups.append(g)

    # ---- 音频映射（先索引 0，再 1..N-1）----
    if audio_copy:
        groups.append(["-map", "0:a", "-c:a:0", "copy"])
    else:
        groups.append(["-map", "0:a", "-c:a:0", "aac", "-b:a:0", audio_br, "-ar", "48000"])

    for i in range(1, N):
        groups.append(["-map", f"[a{i}]", f"-c:a:{i}", "aac", f"-b:a:{i}", audio_br, "-ar", "48000"])

    # ---- 通用编码参数 ----
    groups.append(["-bf", "0", "-g", str(gop), "-keyint_min", str(gop),
                   "-r", str(fps), "-sc_threshold", "0"])

    # ---- HLS 参数 ----
    flags = "delete_segments+independent_segments"
    if args.append_list:
        flags += "+append_list"
    groups.append(["-f", "hls", "-hls_time", str(hls_time),
                   "-hls_list_size", str(args.hls_list_size), "-hls_flags", flags])
    groups.append(["-hls_delete_threshold", str(args.hls_delete_threshold)])
    groups.append(["-hls_segment_filename", f"{out_dir}/%v/seg_%03d.ts"])
    groups.append(["-master_pl_name", "master.m3u8"])
    vsm = " ".join(f"v:{i},a:{i},name:{presets[i][0]}" for i in range(N))
    groups.append(["-var_stream_map", vsm])
    groups.append([f"{out_dir}/%v/index.m3u8"])

    return groups, presets, copy_top, audio_copy, gop, warn


def quote(tok):
    """需要时给 token 加双引号，保证可直接粘贴执行。"""
    if tok and any(c in tok for c in " ;[]"):
        return f'"{tok}"'
    return tok


def render(groups):
    return " \\\n  ".join(" ".join(quote(t) for t in g) for g in groups)


def main():
    ap = argparse.ArgumentParser(
        description="HLS ABR 多清晰度转码命令生成器（索引 0=copy 档，其余从 1 开始）",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("-i", "--input", required=True, help="输入源（rtmp/rtsp/srt/http/本地文件）")
    ap.add_argument("-o", "--output", required=True, help="HLS 输出目录，如 /mnt/hls")
    ap.add_argument("--presets", default="1080p,720p,480p",
                    help=f"档位列表，逗号分隔（高→低）。可用：{','.join(PRESETS.keys())}")
    ap.add_argument("--bitrates", default=None,
                    help="自定义各档码率，逗号分隔，支持 k/m，如 20000k,9000k,5000k,2500k")
    ap.add_argument("--fps", type=int, default=30, help="帧率（默认 30）")
    ap.add_argument("--gop", type=int, default=None, help="GOP 帧数（覆盖 --gop-seconds），如 30")
    ap.add_argument("--gop-seconds", type=float, default=1.0,
                    help="GOP 秒数（默认 1.0，即 30fps 下 -g 30；须能整除 hls-time）")
    ap.add_argument("--hls-time", type=int, default=3, help="切片时长秒（默认 3）")
    ap.add_argument("--hls-list-size", type=int, default=20, help="m3u8 保留分片数（默认 20）")
    ap.add_argument("--hls-delete-threshold", type=int, default=10, help="滚出清单后多留几片（默认 10）")
    ap.add_argument("--audio-bitrate", default="128k", help="音频码率（默认 128k）")
    ap.add_argument("--copy-top", dest="copy_top", action="store_true", default=True,
                    help="索引 0（最高清）视频直接 copy（默认开启）")
    ap.add_argument("--no-copy-top", dest="copy_top", action="store_false",
                    help="索引 0 也转码（源非 H.264 或分辨率不匹配时用）")
    ap.add_argument("--audio-copy", dest="audio_copy", action="store_true", default=True,
                    help="索引 0 音频直接 copy（默认开启，要求源音频是 AAC）")
    ap.add_argument("--no-audio-copy", dest="audio_copy", action="store_false",
                    help="索引 0 音频也转成 AAC（源音频是 Opus 等时用）")
    ap.add_argument("--hw", default="software", choices=HW_ENCODERS.keys(),
                    help="编码器：software(默认)/rkmpp/vaapi/nvenc")
    ap.add_argument("--x264-preset", default="veryfast",
                    help="libx264 preset（默认 veryfast；填 none 则不输出该参数）")
    ap.add_argument("--maxrate-factor", type=float, default=1.0, help="maxrate = b:v × 系数（默认 1.0）")
    ap.add_argument("--bufsize-factor", type=float, default=2.0, help="bufsize = b:v × 系数（默认 2.0）")
    ap.add_argument("--top-bitrate", default=None,
                    help="索引 0 copy 档用来算 BANDWIDTH 的码率，如 20000k（默认取该档预设值）")
    ap.add_argument("--re", action="store_true", help="以原生帧率读取（默认对直播源已开启）")
    ap.add_argument("--reconnect", action="store_true", help="对网络源加自动重连参数")
    ap.add_argument("--append-list", action="store_true", help="追加到已有分片清单（重启不丢历史）")
    ap.add_argument("--loglevel", default="", help="ffmpeg 日志级别：quiet/error/warning/info/debug（默认不加）")
    ap.add_argument("--dry-run", action="store_true", help="只打印命令（默认行为）")
    ap.add_argument("--run", action="store_true", help="直接执行")

    args = ap.parse_args()
    groups, presets, copy_top, audio_copy, gop, warn = build_groups(args)
    cmd = [t for g in groups for t in g]

    # ---------- 打印 ----------
    print("=" * 72)
    print("📋 生成的 FFmpeg 命令：")
    print("=" * 72)
    print(render(groups))
    print()
    print("🎞️  档位配置（索引 0 固定为最高清档，其余从 1 开始）：")
    for i, (name, w, h, br) in enumerate(presets):
        if i == 0:
            vtag = "copy（省CPU）" if copy_top else "转码"
            atag = "copy" if audio_copy else "aac"
        else:
            vtag, atag = "转码", "aac"
        print(f"  索引 {i}: {name:6s} {w}x{h:<5} {fmt_rate(br):>7s}  视频={vtag}  音频={atag}")
    print()
    print(f"📁 输出目录：{args.output}")
    print(f"🎬 GOP：{gop} 帧（{args.fps}fps × {args.gop_seconds:g}s）；分片：{args.hls_time}s")
    print(f"🔧 视频编码器：{HW_ENCODERS[args.hw]}")
    print(f"🧩 变量目录：  {args.output.rstrip('/')}/%v/  （%v 展开为 4k/2k/1080p/720p 等档位名）")
    for w_ in warn:
        print(f"⚠️  {w_}")
    print()

    if not args.run:
        print("💡 只打印不执行。加 --run 直接跑，或复制上面的命令手动执行。")
        return 0

    # ---------- 执行 ----------
    os.makedirs(args.output, exist_ok=True)
    for name, _, _, _ in presets:
        os.makedirs(os.path.join(args.output, name), exist_ok=True)
    print("▶️  开始执行...")
    try:
        subprocess.run(cmd, check=True)
    except KeyboardInterrupt:
        print("\n⏹️  已停止。")
        return 130
    except subprocess.CalledProcessError as e:
        print(f"❌ FFmpeg 退出码：{e.returncode}", file=sys.stderr)
        return e.returncode
    return 0


if __name__ == "__main__":
    sys.exit(main())

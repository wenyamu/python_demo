    # ---------- 执行前准备：seq 模式（直播/VOD）先一次性流拷贝拼接一轮音频 ----------
    def preconcat_seq_audio(audios, out_file):
        """用 concat demuxer 把多段音频拼成一轮可循环的标准 aac m4a（秒级完成）。
        注意：不能用 -c:a copy——MP3 VBR 时间戳直接 copy 进 MP4/M4A 容器会因
        CTS/DTS 不匹配报错；这里一次性硬编码成 aac 128k/48k/stereo，
        后续主进程就可以对这一个标准 m4a 做 -stream_loop -1 无限循环，稳定可靠。"""
        import tempfile
        list_fd, list_path = tempfile.mkstemp(prefix="seqlist_", suffix=".txt", dir=os.path.dirname(out_file) or ".")
        try:
            with os.fdopen(list_fd, "w", encoding="utf-8") as f:
                for ap in audios:
                    escaped = ap.replace("'", "'\\''")
                    f.write(f"file '{escaped}'\n")
            cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
                   "-f", "concat", "-safe", "0", "-i", list_path,
                   "-c:a", "aac", "-b:a", "128k", "-ar", "48000", "-ac", "2",
                   "-movflags", "+faststart", out_file]
            print(f"🔧 预拼接 seq 一轮音频 → {os.path.basename(out_file)}（一次性编码为 aac）")
            subprocess.run(cmd, check=True)
        finally:
            try: os.remove(list_path)
            except OSError: pass

    # ---------- 执行 ----------
    os.makedirs(args.output, exist_ok=True)
    for name, _, _, _ in presets:
        os.makedirs(os.path.join(args.output, name), exist_ok=True)
    if preconcat is not None:
        audios, cfile = preconcat
        if not os.path.exists(cfile):
            preconcat_seq_audio(audios, cfile)
        else:
            print(f"🔧 已存在预拼接文件 {os.path.basename(cfile)}，跳过（删除可重建）")
    print("▶️  开始执行...")
    try:
        subprocess.run(cmd, check=True)
    except KeyboardInterrupt:
        print("\n⏹️  已停止。")
        return 130
    except subprocess.CalledProcessError as e:
        print(f"❌ FFmpeg 退出码：{e.returncode}", file=sys.stderr)
        return e.returncode
    return 0

